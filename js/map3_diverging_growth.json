{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 430,
  "height": 330,
  "autosize": { "type": "fit-x", "contains": "padding" },
  "padding": { "top": 5, "left": 5, "right": 5, "bottom": 5 },
  "projection": {
    "type": "equirectangular",
    "center": [133.5, -26.5],
    "scale": 530
  },
  "layer": [
    {
      "data": { "url": "data/australian_livestock_disposals_by_state.csv" },
      "transform": [
        {
          "filter": "datum.Year == '2020-21' || datum.Year == '2024-25'"
        },
        {
          "calculate": "toNumber(datum.Value_AUD)",
          "as": "Val_Num"
        },
        {
          "aggregate": [
            { "op": "sum", "field": "Val_Num", "as": "Total_AUD" }
          ],
          "groupby": ["State", "Year"]
        },
        {
          "pivot": "Year",
          "value": "Total_AUD",
          "groupby": ["State"]
        },
        {
          "calculate": "((datum['2024-25'] - datum['2020-21']) / datum['2020-21']) * 100",
          "as": "Growth_Pct"
        },
        {
          "calculate": "datum['2020-21'] / 1000000",
          "as": "Val_2021_M"
        },
        {
          "calculate": "datum['2024-25'] / 1000000",
          "as": "Val_2425_M"
        },
        {
          "lookup": "State",
          "from": {
            "data": {
              "url": "data/aus_states.geojson",
              "format": { "type": "json", "property": "features" }
            },
            "key": "State"
          },
          "as": "geo"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.3
      },
      "encoding": {
        "shape": { "field": "geo", "type": "geojson" },
        "color": {
          "field": "Growth_Pct",
          "type": "quantitative",
          "title": "5-Yr Growth (%)",
          "scale": {
            "scheme": "purpleorange",
            "domain": [-55, 55],
            "domainMid": 0
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "gradientLength": 180,
            "values": [-50, -25, 0, 25, 50],
            "format": "+.0f",
            "titleFontSize": 10.5,
            "labelFontSize": 10
          }
        },
        "tooltip": [
          { "field": "State", "type": "nominal", "title": "State / Territory" },
          { "field": "Growth_Pct", "type": "quantitative", "title": "5-Yr Output Change (%)", "format": "+.1f" },
          { "field": "Val_2021_M", "type": "quantitative", "title": "2020–21 Output ($M)", "format": "$,.1f" },
          { "field": "Val_2425_M", "type": "quantitative", "title": "2024–25 Output ($M)", "format": "$,.1f" }
        ]
      }
    },
    {
      "data": {
        "values": [
          { "lon": 133.5, "lat": -20.0, "label": "NT: -16.3%" },
          { "lon": 144.8, "lat": -23.0, "label": "QLD: +36.0%" },
          { "lon": 135.0, "lat": -29.2, "label": "SA: +51.1%" },
          { "lon": 144.5, "lat": -36.8, "label": "VIC: +47.5%" },
          { "lon": 147.0, "lat": -32.0, "label": "NSW: +40.4%" },
          { "lon": 122.2, "lat": -25.5, "label": "WA: +8.5%" }
        ]
      },
      "mark": {
        "type": "text",
        "font": "DM Sans",
        "fontSize": 10,
        "fontWeight": "bold",
        "fill": "#1E242B",
        "halo": "#FFFFFF",
        "haloWidth": 2
      },
      "encoding": {
        "longitude": { "field": "lon", "type": "quantitative" },
        "latitude": { "field": "lat", "type": "quantitative" },
        "text": { "field": "label", "type": "nominal" }
      }
    }
  ],
  "config": {
    "font": "DM Sans",
    "view": { "stroke": null }
  }
}
