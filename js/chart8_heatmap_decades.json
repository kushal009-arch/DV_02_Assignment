{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 375,
  "height": 290,
  "autosize": { "type": "fit-x", "contains": "padding" },
  "padding": { "top": 10, "left": 10, "right": 15, "bottom": 5 },
  "data": { "url": "data/australian_apparent_meat_consumption_per_person.csv" },
  "transform": [
    {
      "calculate": "toNumber(slice(datum.Year, 0, 4))",
      "as": "Start_Year"
    },
    {
      "fold": ["Poultry", "Pig_Meat", "Beef_Veal", "Sheep_Meat"],
      "as": ["Meat_Code", "Kg_Val"]
    },
    {
      "calculate": "datum.Meat_Code == 'Poultry' ? 'Poultry' : datum.Meat_Code == 'Pig_Meat' ? 'Pig Meat' : datum.Meat_Code == 'Beef_Veal' ? 'Beef & Veal' : 'Sheep Meat'",
      "as": "Species"
    }
  ],
  "layer": [
    {
      "mark": { "type": "rect", "stroke": "#FFFFFF", "strokeWidth": 0.8 },
      "encoding": {
        "x": {
          "field": "Start_Year",
          "type": "ordinal",
          "title": "Financial Year Start (1988–89 to 2024–25)",
          "axis": {
            "labelAngle": -45,
            "values": [1988, 1992, 1996, 2000, 2004, 2008, 2012, 2016, 2020, 2024],
            "labelFontSize": 10.5
          }
        },
        "y": {
          "field": "Species",
          "type": "nominal",
          "title": null,
          "sort": ["Poultry", "Beef & Veal", "Pig Meat", "Sheep Meat"],
          "axis": { "labelFontSize": 11 }
        },
        "color": {
          "field": "Kg_Val",
          "type": "quantitative",
          "title": "kg / person",
          "scale": {
            "scheme": "yellowgreenblue",
            "domain": [5, 55]
          },
          "legend": {
            "orient": "top",
            "gradientLength": 220,
            "values": [10, 20, 30, 40, 50],
            "offset": 12,
            "titleFontSize": 10.5,
            "labelFontSize": 10
          }
        },
        "tooltip": [
          { "field": "Year", "type": "nominal", "title": "Financial Year" },
          { "field": "Species", "type": "nominal", "title": "Meat Type" },
          { "field": "Kg_Val", "type": "quantitative", "title": "Consumption (kg/person)", "format": ".2f" }
        ]
      }
    },
    {
      "data": {
        "values": [
          { "Start_Year": 2024, "Species": "Poultry", "note": "2010–25: 44 to 54 kg Surge" }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -8,
        "dy": 0,
        "font": "DM Sans",
        "fontSize": 10.5,
        "fontWeight": "bold",
        "fill": "#FFFFFF",
        "halo": "#0C2C84",
        "haloWidth": 2
      },
      "encoding": {
        "x": { "field": "Start_Year", "type": "ordinal" },
        "y": {
          "field": "Species",
          "type": "nominal",
          "sort": ["Poultry", "Beef & Veal", "Pig Meat", "Sheep Meat"]
        },
        "text": { "field": "note", "type": "nominal" }
      }
    },
    {
      "data": {
        "values": [
          { "Start_Year": 2024, "Species": "Sheep Meat", "note": "Fades to 5.3 kg (2024–25)" }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -8,
        "dy": 0,
        "font": "DM Sans",
        "fontSize": 10.5,
        "fontWeight": "bold",
        "fill": "#1E242B",
        "halo": "#FFFFCC",
        "haloWidth": 2.5
      },
      "encoding": {
        "x": { "field": "Start_Year", "type": "ordinal" },
        "y": {
          "field": "Species",
          "type": "nominal",
          "sort": ["Poultry", "Beef & Veal", "Pig Meat", "Sheep Meat"]
        },
        "text": { "field": "note", "type": "nominal" }
      }
    }
  ],
  "config": {
    "font": "DM Sans",
    "view": { "stroke": null }
  }
}
