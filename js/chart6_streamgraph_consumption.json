{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 380,
  "height": 300,
  "autosize": { "type": "fit-x", "contains": "padding" },
  "padding": { "top": 10, "left": 10, "right": 20, "bottom": 5 },
  "data": { "url": "data/australian_apparent_meat_consumption_per_person.csv" },
  "transform": [
    {
      "calculate": "toNumber(slice(datum.Year, 0, 4))",
      "as": "Year_Num"
    },
    {
      "fold": ["Poultry", "Pig_Meat", "Beef_Veal", "Sheep_Meat"],
      "as": ["Meat_Code", "Kg_Per_Person"]
    },
    {
      "calculate": "datum.Meat_Code == 'Poultry' ? 'Poultry' : datum.Meat_Code == 'Pig_Meat' ? 'Pig Meat' : datum.Meat_Code == 'Beef_Veal' ? 'Beef & Veal' : 'Sheep Meat'",
      "as": "Species"
    },
    {
      "calculate": "datum.Species == 'Poultry' ? 1 : datum.Species == 'Pig Meat' ? 2 : datum.Species == 'Beef & Veal' ? 3 : 4",
      "as": "Species_Order"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "area",
        "interpolate": "monotone",
        "opacity": 0.88
      },
      "encoding": {
        "x": {
          "field": "Year_Num",
          "type": "quantitative",
          "title": "Financial Year (1988–89 to 2024–25)",
          "scale": { "domain": [1988, 2024] },
          "axis": {
            "format": "d",
            "labelFontSize": 10.5,
            "values": [1990, 1995, 2000, 2005, 2010, 2015, 2020]
          }
        },
        "y": {
          "field": "Kg_Per_Person",
          "type": "quantitative",
          "stack": "center",
          "axis": null
        },
        "color": {
          "field": "Species",
          "type": "nominal",
          "title": "Meat Type",
          "scale": {
            "domain": ["Beef & Veal", "Sheep Meat", "Poultry", "Pig Meat"],
            "range": ["#0072B2", "#E69F00", "#009E73", "#CC79A7"]
          },
          "legend": { "orient": "top", "offset": 12 }
        },
        "order": { "field": "Species_Order", "type": "quantitative" },
        "tooltip": [
          { "field": "Year", "type": "nominal", "title": "Financial Year" },
          { "field": "Species", "type": "nominal", "title": "Meat Type" },
          { "field": "Kg_Per_Person", "type": "quantitative", "title": "Consumption (kg/person)", "format": ".2f" }
        ]
      }
    },
    {
      "data": {
        "values": [
          { "Year_Num": 1990, "label": "1988–89: Beef Led (40.7 kg)" }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "font": "DM Sans",
        "fontSize": 11.5,
        "fontWeight": "bold",
        "fill": "#FFFFFF",
        "halo": "#1E242B",
        "haloWidth": 2.5
      },
      "encoding": {
        "x": {
          "field": "Year_Num",
          "type": "quantitative",
          "scale": { "domain": [1988, 2024] }
        },
        "y": { "value": 95 },
        "text": { "field": "label", "type": "nominal" }
      }
    },
    {
      "data": {
        "values": [
          { "Year_Num": 2022, "label": "2024–25: Poultry Surge (53.9 kg)" }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -6,
        "font": "DM Sans",
        "fontSize": 11.5,
        "fontWeight": "bold",
        "fill": "#FFFFFF",
        "halo": "#1E242B",
        "haloWidth": 2.5
      },
      "encoding": {
        "x": {
          "field": "Year_Num",
          "type": "quantitative",
          "scale": { "domain": [1988, 2024] }
        },
        "y": { "value": 215 },
        "text": { "field": "label", "type": "nominal" }
      }
    }
  ],
  "config": {
    "font": "DM Sans",
    "view": { "stroke": null },
    "axisY": { "grid": false }
  }
}
