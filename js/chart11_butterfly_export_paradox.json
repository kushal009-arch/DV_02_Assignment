{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": { "url": "data/australian_export_vs_diet_share_2025.csv" },
  "spacing": 8,
  "autosize": "pad",
  "padding": { "top": 14, "left": 6, "right": 6, "bottom": 14 },
  "hconcat": [
    {
      "title": { "text": "2024–25 Farm Value Share (%)", "anchor": "middle", "fontSize": 11, "color": "#475569", "font": "DM Sans" },
      "width": 140,
      "height": 180,
      "layer": [
        {
          "mark": { "type": "bar", "size": 24, "cornerRadiusTopLeft": 3, "cornerRadiusBottomLeft": 3 },
          "encoding": {
            "y": {
              "field": "Species",
              "type": "nominal",
              "axis": null,
              "sort": ["Cattle / Beef", "Sheep / Lamb", "Poultry", "Pig / Pork"]
            },
            "x": {
              "field": "Farm_Value_Share",
              "type": "quantitative",
              "scale": { "domain": [0, 80], "reverse": true },
              "axis": { "title": null, "values": [0, 20, 40, 60], "labelFontSize": 10 }
            },
            "color": {
              "field": "Species",
              "type": "nominal",
              "scale": {
                "domain": ["Cattle / Beef", "Sheep / Lamb", "Poultry", "Pig / Pork"],
                "range": ["#0072B2", "#E69F00", "#009E73", "#CC79A7"]
              },
              "legend": null
            },
            "tooltip": [
              { "field": "Species", "type": "nominal", "title": "Livestock / Meat" },
              { "field": "Production_AUD_B", "type": "quantitative", "title": "Farm Output ($B AUD)", "format": "$,.2f" },
              { "field": "Farm_Value_Share", "type": "quantitative", "title": "Farm Value Share (%)", "format": ".1f" }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "right",
            "dx": -6,
            "font": "DM Sans",
            "fontSize": 10.5,
            "fontWeight": "bold",
            "fill": "#1E242B"
          },
          "encoding": {
            "y": { "field": "Species", "type": "nominal", "sort": ["Cattle / Beef", "Sheep / Lamb", "Poultry", "Pig / Pork"] },
            "x": { "field": "Farm_Value_Share", "type": "quantitative", "scale": { "domain": [0, 80], "reverse": true } },
            "text": { "field": "Farm_Value_Share", "type": "quantitative", "format": ".1f" }
          }
        }
      ]
    },
    {
      "width": 85,
      "height": 180,
      "view": { "stroke": null },
      "mark": {
        "type": "text",
        "align": "center",
        "font": "DM Sans",
        "fontSize": 11,
        "fontWeight": "bold",
        "fill": "#1E242B"
      },
      "encoding": {
        "y": {
          "field": "Species",
          "type": "nominal",
          "axis": null,
          "sort": ["Cattle / Beef", "Sheep / Lamb", "Poultry", "Pig / Pork"]
        },
        "text": { "field": "Species", "type": "nominal" }
      }
    },
    {
      "title": { "text": "2024–25 Domestic Diet Share (%)", "anchor": "middle", "fontSize": 11, "color": "#475569", "font": "DM Sans" },
      "width": 140,
      "height": 180,
      "layer": [
        {
          "mark": { "type": "bar", "size": 24, "cornerRadiusTopRight": 3, "cornerRadiusBottomRight": 3 },
          "encoding": {
            "y": {
              "field": "Species",
              "type": "nominal",
              "axis": null,
              "sort": ["Cattle / Beef", "Sheep / Lamb", "Poultry", "Pig / Pork"]
            },
            "x": {
              "field": "Diet_Share",
              "type": "quantitative",
              "scale": { "domain": [0, 80] },
              "axis": { "title": null, "values": [0, 20, 40, 60], "labelFontSize": 10 }
            },
            "color": {
              "field": "Species",
              "type": "nominal",
              "scale": {
                "domain": ["Cattle / Beef", "Sheep / Lamb", "Poultry", "Pig / Pork"],
                "range": ["#0072B2", "#E69F00", "#009E73", "#CC79A7"]
              },
              "legend": null
            },
            "tooltip": [
              { "field": "Species", "type": "nominal", "title": "Meat Type" },
              { "field": "Consumption_Kg_Person", "type": "quantitative", "title": "Intake (kg/person)", "format": ".1f" },
              { "field": "Diet_Share", "type": "quantitative", "title": "Domestic Diet Share (%)", "format": ".1f" }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 6,
            "font": "DM Sans",
            "fontSize": 10.5,
            "fontWeight": "bold",
            "fill": "#1E242B"
          },
          "encoding": {
            "y": { "field": "Species", "type": "nominal", "sort": ["Cattle / Beef", "Sheep / Lamb", "Poultry", "Pig / Pork"] },
            "x": { "field": "Diet_Share", "type": "quantitative", "scale": { "domain": [0, 80] } },
            "text": { "field": "Diet_Share", "type": "quantitative", "format": ".1f" }
          }
        }
      ]
    }
  ],
  "config": { "font": "DM Sans", "view": { "stroke": null } }
}
