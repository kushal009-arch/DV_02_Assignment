{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": { "url": "data/australian_apparent_meat_consumption_per_person.csv" },
  "transform": [
    {
      "calculate": "toNumber(slice(datum.Year, 0, 4))",
      "as": "Year_Num"
    },
    {
      "fold": ["Poultry", "Pig_Meat", "Beef_Veal", "Sheep_Meat"],
      "as": ["Meat_Code", "Kg_Per_Person"]
    },
    {
      "calculate": "datum.Meat_Code == 'Poultry' ? 'Poultry' : datum.Meat_Code == 'Pig_Meat' ? 'Pig Meat' : datum.Meat_Code == 'Beef_Veal' ? 'Beef & Veal' : 'Sheep Meat'",
      "as": "Species"
    }
  ],
  "vconcat": [
    {
      "width": 380,
      "height": 200,
      "autosize": { "type": "fit-x", "contains": "padding" },
      "layer": [
        {
          "mark": { "type": "line", "strokeWidth": 2.8, "interpolate": "monotone" },
          "encoding": {
            "x": {
              "field": "Year_Num",
              "type": "quantitative",
              "scale": { "domain": { "param": "timeBrush" } },
              "title": null,
              "axis": {
                "format": "d",
                "labelFontSize": 10.5,
                "values": [1990, 1995, 2000, 2005, 2010, 2015, 2020]
              }
            },
            "y": {
              "field": "Kg_Per_Person",
              "type": "quantitative",
              "title": "Consumption (kg / person / yr)",
              "scale": { "domain": [0, 58] },
              "axis": { "labelFontSize": 10.5, "titleFontSize": 11 }
            },
            "color": {
              "field": "Species",
              "type": "nominal",
              "title": "Meat Type",
              "scale": {
                "domain": ["Beef & Veal", "Sheep Meat", "Poultry", "Pig Meat"],
                "range": ["#0072B2", "#E69F00", "#009E73", "#CC79A7"]
              },
              "legend": { "orient": "top", "offset": 10 }
            }
          }
        },
        {
          "mark": { "type": "circle", "size": 38 },
          "encoding": {
            "x": {
              "field": "Year_Num",
              "type": "quantitative",
              "scale": { "domain": { "param": "timeBrush" } }
            },
            "y": { "field": "Kg_Per_Person", "type": "quantitative" },
            "color": { "field": "Species", "type": "nominal" },
            "tooltip": [
              { "field": "Year", "type": "nominal", "title": "Financial Year" },
              { "field": "Species", "type": "nominal", "title": "Meat Type" },
              { "field": "Kg_Per_Person", "type": "quantitative", "title": "Consumption (kg/person)", "format": ".2f" }
            ]
          }
        },
        {
          "data": {
            "values": [
              { "yr": 2001, "label": "2001–02: Poultry passes Beef" },
              { "yr": 2015, "label": "2015–16: Pork passes Beef" }
            ]
          },
          "mark": {
            "type": "rule",
            "stroke": "#64748B",
            "strokeDash": [3, 3],
            "strokeWidth": 1.2
          },
          "encoding": {
            "x": {
              "field": "yr",
              "type": "quantitative",
              "scale": { "domain": { "param": "timeBrush" } }
            }
          }
        },
        {
          "data": {
            "values": [
              { "yr": 2001, "kg": 52.0, "label": "2001–02: Poultry overtakes Beef" }
            ]
          },
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 6,
            "font": "DM Sans",
            "fontSize": 10.5,
            "fontStyle": "italic",
            "fontWeight": "bold",
            "fill": "#1E242B",
            "halo": "#FFFFFF",
            "haloWidth": 3.0
          },
          "encoding": {
            "x": {
              "field": "yr",
              "type": "quantitative",
              "scale": { "domain": { "param": "timeBrush" } }
            },
            "y": { "field": "kg", "type": "quantitative" },
            "text": { "field": "label", "type": "nominal" }
          }
        },
        {
          "data": {
            "values": [
              { "yr": 2015, "kg": 34.0, "label": "2015–16: Pork passes Beef" }
            ]
          },
          "mark": {
            "type": "text",
            "align": "right",
            "dx": -6,
            "font": "DM Sans",
            "fontSize": 10.5,
            "fontStyle": "italic",
            "fontWeight": "bold",
            "fill": "#1E242B",
            "halo": "#FFFFFF",
            "haloWidth": 3.0
          },
          "encoding": {
            "x": {
              "field": "yr",
              "type": "quantitative",
              "scale": { "domain": { "param": "timeBrush" } }
            },
            "y": { "field": "kg", "type": "quantitative" },
            "text": { "field": "label", "type": "nominal" }
          }
        }
      ]
    },
    {
      "width": 380,
      "height": 50,
      "autosize": { "type": "fit-x", "contains": "padding" },
      "params": [
        {
          "name": "timeBrush",
          "select": { "type": "interval", "encodings": ["x"] }
        }
      ],
      "mark": { "type": "area", "opacity": 0.35, "interpolate": "monotone" },
      "encoding": {
        "x": {
          "field": "Year_Num",
          "type": "quantitative",
          "scale": { "domain": [1988, 2024] },
          "title": "Drag across timeline to zoom period (1988–2024)",
          "axis": {
            "format": "d",
            "labelFontSize": 9.5,
            "titleFontSize": 10.5,
            "values": [1990, 1995, 2000, 2005, 2010, 2015, 2020]
          }
        },
        "y": {
          "field": "Kg_Per_Person",
          "type": "quantitative",
          "stack": "zero",
          "title": null,
          "axis": null
        },
        "color": { "field": "Species", "type": "nominal", "legend": null }
      }
    }
  ],
  "config": {
    "font": "DM Sans",
    "view": { "stroke": null }
  }
}
