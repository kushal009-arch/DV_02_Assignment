{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "autosize": "pad",
  "padding": { "top": 10, "left": 10, "right": 40, "bottom": 10 },
  "data": {
    "url": "data/state_profiles_2024_25.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Cattle_Share_Pct": "number",
        "Sheep_Share_Pct": "number",
        "Poultry_Share_Pct": "number",
        "Pig_Share_Pct": "number"
      }
    }
  },
  "transform": [
    {
      "fold": ["Cattle_Share_Pct", "Sheep_Share_Pct", "Poultry_Share_Pct", "Pig_Share_Pct"],
      "as": ["Species_Key", "Share_Pct"]
    },
    {
      "calculate": "toNumber(datum.Share_Pct)",
      "as": "Share_Pct"
    },
    {
      "calculate": "datum.Species_Key == 'Cattle_Share_Pct' ? 'Cattle' : datum.Species_Key == 'Sheep_Share_Pct' ? 'Sheep' : datum.Species_Key == 'Poultry_Share_Pct' ? 'Poultry' : 'Pig'",
      "as": "Species"
    },
    {
      "calculate": "datum.State == 'Northern Territory' || datum.State == 'Queensland' || datum.State == 'Western Australia' ? 'Northern Pastoral' : 'Southern Mixed'",
      "as": "Zone"
    },
    {
      "calculate": "datum.State_Short == 'NT' && datum.Species == 'Cattle' ? '50% Dominance Line' : null",
      "as": "Threshold_Label"
    }
  ],
  "facet": {
    "row": {
      "field": "Zone",
      "type": "nominal",
      "title": null,
      "header": {
        "orient": "top",
        "labelAnchor": "start",
        "labelFontSize": 12,
        "labelFontWeight": "bold",
        "labelColor": "#1E242B",
        "labelPadding": 8
      }
    }
  },
  "resolve": {
    "scale": {
      "y": "independent"
    }
  },
  "spec": {
    "width": 380,
    "height": 115,
    "layer": [
      {
        "transform": [
          { "filter": "datum.Species == 'Cattle'" }
        ],
        "mark": {
          "type": "rule",
          "color": "#E2E8F0",
          "strokeWidth": 1.5,
          "strokeCap": "round"
        },
        "encoding": {
          "y": {
            "field": "State_Short",
            "type": "nominal",
            "title": null,
            "sort": ["NT", "QLD", "WA", "TAS", "NSW", "ACT", "VIC", "SA"]
          },
          "x": { "datum": 0 },
          "x2": { "datum": 100 }
        }
      },
      {
        "mark": {
          "type": "rule",
          "stroke": "#64748B",
          "strokeDash": [4, 4],
          "strokeWidth": 1.2
        },
        "encoding": {
          "x": { "datum": 50 }
        }
      },
      {
        "transform": [
          { "filter": "datum.Threshold_Label != null" }
        ],
        "mark": {
          "type": "text",
          "align": "center",
          "dy": -13,
          "font": "DM Sans",
          "fontSize": 9.5,
          "fontStyle": "italic",
          "fontWeight": "bold",
          "fill": "#475569",
          "halo": "#FFFFFF",
          "haloWidth": 2
        },
        "encoding": {
          "x": { "datum": 50 },
          "y": {
            "field": "State_Short",
            "type": "nominal",
            "sort": ["NT", "QLD", "WA", "TAS", "NSW", "ACT", "VIC", "SA"]
          },
          "text": { "field": "Threshold_Label", "type": "nominal" }
        }
      },
      {
        "transform": [
          { "filter": "datum.Share_Pct > 0" }
        ],
        "mark": {
          "type": "circle",
          "size": 110,
          "opacity": 0.9,
          "stroke": "#FFFFFF",
          "strokeWidth": 1.5
        },
        "encoding": {
          "y": {
            "field": "State_Short",
            "type": "nominal",
            "title": null,
            "sort": ["NT", "QLD", "WA", "TAS", "NSW", "ACT", "VIC", "SA"],
            "axis": {
              "labelFontSize": 11,
              "labelFontWeight": "bold",
              "labelPadding": 6
            }
          },
          "x": {
            "field": "Share_Pct",
            "type": "quantitative",
            "title": "Share of State Output (%)",
            "scale": { "domain": [0, 100] },
            "axis": {
              "values": [0, 25, 50, 75, 100],
              "format": ".0f",
              "labelFontSize": 10.5,
              "titleFontSize": 11
            }
          },
          "color": {
            "field": "Species",
            "type": "nominal",
            "scale": {
              "domain": ["Cattle", "Sheep", "Poultry", "Pig"],
              "range": ["#0072B2", "#E69F00", "#009E73", "#CC79A7"]
            },
            "legend": {
              "orient": "top",
              "direction": "horizontal",
              "title": null,
              "columns": 4,
              "labelFontSize": 10.5,
              "symbolType": "circle",
              "symbolSize": 90,
              "symbolStrokeWidth": 2.2,
              "columnPadding": 14,
              "offset": 8
            }
          },
          "order": {
            "field": "Share_Pct",
            "sort": "descending"
          },
          "tooltip": [
            { "field": "State", "type": "nominal", "title": "State / Territory" },
            { "field": "Zone", "type": "nominal", "title": "Farming Zone" },
            { "field": "Species", "type": "nominal", "title": "Species" },
            { "field": "Share_Pct", "type": "quantitative", "title": "Share of Output (%)", "format": ".1f" }
          ]
        }
      }
    ]
  },
  "config": {
    "font": "DM Sans",
    "view": { "stroke": null }
  }
}
