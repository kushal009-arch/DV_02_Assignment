{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 430,
  "height": 330,
  "autosize": { "type": "fit-x", "contains": "padding" },
  "padding": { "top": 5, "left": 5, "right": 5, "bottom": 5 },
  "params": [
    {
      "name": "YearSelect",
      "value": "2024-25",
      "bind": {
        "input": "select",
        "options": ["2024-25", "2023-24", "2022-23", "2021-22", "2020-21"],
        "labels": ["2024–25", "2023–24", "2022–23", "2021–22", "2020–21"],
        "name": "Financial Year: "
      }
    },
    {
      "name": "SpeciesSelect",
      "value": "All",
      "bind": {
        "input": "select",
        "options": ["All", "Cattle", "Sheep", "Poultry", "Pig"],
        "labels": ["All Major Species", "Cattle Only", "Sheep Only", "Poultry Only", "Pig Only"],
        "name": "Species: "
      }
    }
  ],
  "projection": {
    "type": "equirectangular",
    "center": [133.5, -26.5],
    "scale": 530
  },
  "layer": [
    {
      "data": {
        "url": "data/aus_states.geojson",
        "format": { "type": "json", "property": "features" }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F2EFE9",
        "stroke": "#C8C2B6",
        "strokeWidth": 1
      }
    },
    {
      "data": { "url": "data/australian_livestock_disposals_by_state.csv" },
      "transform": [
        {
          "calculate": "toNumber(datum.Value_AUD)",
          "as": "Val_Num"
        },
        { "filter": "datum.Year == YearSelect && datum.Val_Num > 0" },
        {
          "joinaggregate": [
            { "op": "sum", "field": "Val_Num", "as": "State_Total_AUD" }
          ],
          "groupby": ["State"]
        },
        {
          "calculate": "SpeciesSelect == 'All' ? 1 : (datum.Livestock_Type == SpeciesSelect ? 1 : 0)",
          "as": "matches_selection"
        },
        { "filter": "datum.matches_selection == 1" },
        {
          "window": [
            { "op": "row_number", "as": "state_row_idx" }
          ],
          "sort": [{ "field": "Val_Num", "order": "descending" }],
          "groupby": ["State"]
        },
        { "filter": "datum.state_row_idx == 1" },
        {
          "calculate": "datum.State == 'Queensland' ? 144.5 : datum.State == 'New South Wales' ? 147.0 : datum.State == 'Victoria' ? 144.3 : datum.State == 'South Australia' ? 135.5 : datum.State == 'Western Australia' ? 122.0 : datum.State == 'Tasmania' ? 146.6 : datum.State == 'Northern Territory' ? 133.5 : 149.1",
          "as": "base_lon"
        },
        {
          "calculate": "datum.State == 'Queensland' ? -22.5 : datum.State == 'New South Wales' ? -32.2 : datum.State == 'Victoria' ? -36.8 : datum.State == 'South Australia' ? -30.0 : datum.State == 'Western Australia' ? -25.5 : datum.State == 'Tasmania' ? -42.0 : datum.State == 'Northern Territory' ? -19.5 : -35.3",
          "as": "base_lat"
        },
        {
          "calculate": "SpeciesSelect == 'All' ? (datum.State_Total_AUD / 1000000) : (datum.Val_Num / 1000000)",
          "as": "Display_Val_M"
        },
        {
          "calculate": "SpeciesSelect == 'All' ? 'Total (All Species)' : datum.Livestock_Type",
          "as": "Display_Type"
        },
        {
          "calculate": "SpeciesSelect == 'All' ? 100.0 : ((datum.Val_Num / datum.State_Total_AUD) * 100)",
          "as": "Share_Of_State_Pct"
        },
        {
          "calculate": "datum.State_Total_AUD / 1000000",
          "as": "State_Total_M"
        },
        {
          "calculate": "datum.State == 'Queensland' ? 'Cattle (85.1%)' : datum.State == 'Victoria' ? 'Cattle (48.0%)' : datum.State == 'New South Wales' ? 'Cattle (55.5%)' : datum.State == 'South Australia' ? 'Cattle (42.4%)' : datum.State == 'Western Australia' ? 'Cattle (61.1%)' : datum.State == 'Tasmania' ? 'Cattle (82.5%)' : datum.State == 'Northern Territory' ? 'Cattle (100.0%)' : 'Cattle (49.3%)'",
          "as": "Dominant_Sector"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.88,
        "stroke": "#FFFFFF",
        "strokeWidth": 1.6
      },
      "encoding": {
        "longitude": { "field": "base_lon", "type": "quantitative" },
        "latitude": { "field": "base_lat", "type": "quantitative" },
        "color": {
          "field": "Display_Type",
          "type": "nominal",
          "title": "Category / Species",
          "scale": {
            "domain": ["Total (All Species)", "Cattle", "Sheep", "Poultry", "Pig"],
            "range": ["#1F3A52", "#0072B2", "#E69F00", "#009E73", "#CC79A7"]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "titleFontSize": 10.5,
            "labelFontSize": 9.5
          }
        },
        "size": {
          "field": "Display_Val_M",
          "type": "quantitative",
          "title": "Output ($M AUD)",
          "scale": {
            "type": "sqrt",
            "domain": [0, 9000],
            "range": [40, 950]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "title": "Output ($M AUD)",
            "values": [1000, 4000, 8500],
            "labelExpr": "'$' + (datum.value / 1000) + 'B'",
            "symbolFillColor": "#1F3A52",
            "symbolFillOpacity": 0.35,
            "symbolStrokeColor": "#1F3A52",
            "symbolStrokeWidth": 1.5,
            "titleFontSize": 10.5,
            "labelFontSize": 9.5,
            "offset": 6
          }
        },
        "order": { "field": "Display_Val_M", "sort": "descending" },
        "tooltip": [
          { "field": "State", "type": "nominal", "title": "State / Territory" },
          { "field": "Display_Type", "type": "nominal", "title": "View / Species" },
          { "field": "Year", "type": "nominal", "title": "Financial Year" },
          { "field": "Display_Val_M", "type": "quantitative", "title": "Disposal Value ($M AUD)", "format": "$,.1f" },
          { "field": "Share_Of_State_Pct", "type": "quantitative", "title": "Share of State Total (%)", "format": ".1f" },
          { "field": "State_Total_M", "type": "quantitative", "title": "State Total Output ($M AUD)", "format": "$,.1f" },
          { "field": "Dominant_Sector", "type": "nominal", "title": "#1 Dominant Sector" }
        ]
      }
    },
    {
      "data": { "url": "data/australian_livestock_disposals_by_state.csv" },
      "transform": [
        { "calculate": "toNumber(datum.Value_AUD)", "as": "Val_Num" },
        { "filter": "datum.Year == YearSelect && datum.Val_Num > 0" },
        {
          "joinaggregate": [
            { "op": "sum", "field": "Val_Num", "as": "State_Total_AUD" }
          ],
          "groupby": ["State"]
        },
        {
          "calculate": "SpeciesSelect == 'All' ? 1 : (datum.Livestock_Type == SpeciesSelect ? 1 : 0)",
          "as": "matches_selection"
        },
        { "filter": "datum.matches_selection == 1" },
        {
          "window": [
            { "op": "row_number", "as": "state_row_idx" }
          ],
          "sort": [{ "field": "Val_Num", "order": "descending" }],
          "groupby": ["State"]
        },
        { "filter": "datum.state_row_idx == 1" },
        {
          "calculate": "SpeciesSelect == 'All' ? (datum.State_Total_AUD / 1000000) : (datum.Val_Num / 1000000)",
          "as": "Display_Val_M"
        },
        {
          "calculate": "SpeciesSelect == 'All' ? 100.0 : ((datum.Val_Num / datum.State_Total_AUD) * 100)",
          "as": "Share_Of_State_Pct"
        },
        {
          "filter": "(SpeciesSelect == 'All' && datum.State == 'Queensland') || (SpeciesSelect == 'Cattle' && (datum.State == 'Queensland' || datum.State == 'Northern Territory')) || (SpeciesSelect == 'Sheep' && datum.State == 'New South Wales') || (SpeciesSelect == 'Poultry' && datum.State == 'New South Wales') || (SpeciesSelect == 'Pig' && (datum.State == 'South Australia' || datum.State == 'Queensland'))"
        },
        {
          "calculate": "datum.State == 'Queensland' ? (SpeciesSelect == 'Pig' ? 144.5 : 145.2) : datum.State == 'Northern Territory' ? 133.5 : datum.State == 'New South Wales' ? 147.0 : 135.0",
          "as": "lon"
        },
        {
          "calculate": "datum.State == 'Queensland' ? (SpeciesSelect == 'Pig' ? -20.5 : -19.0) : datum.State == 'Northern Territory' ? -17.5 : datum.State == 'New South Wales' ? -30.5 : -28.0",
          "as": "lat"
        },
        {
          "calculate": "SpeciesSelect == 'All' ? 'QLD: National Leader ($8.68B Total)' : (SpeciesSelect == 'Cattle' ? (datum.State == 'Queensland' ? 'QLD: Cattle Hub ($' + format(datum.Display_Val_M / 1000, '.2f') + 'B)' : 'NT: ' + format(datum.Share_Of_State_Pct, '.0f') + '% Reliance on Cattle') : (SpeciesSelect == 'Sheep' ? 'NSW: Sheep Hub ($' + (datum.Display_Val_M >= 1000 ? format(datum.Display_Val_M / 1000, '.2f') + 'B' : format(datum.Display_Val_M, ',.0f') + 'M') + ')' : (SpeciesSelect == 'Poultry' ? 'NSW: Top Poultry ($' + (datum.Display_Val_M >= 1000 ? format(datum.Display_Val_M / 1000, '.2f') + 'B' : format(datum.Display_Val_M, ',.0f') + 'M') + ')' : (datum.State == 'South Australia' ? 'SA: Highest Pig Share (' + format(datum.Share_Of_State_Pct, '.1f') + '%)' : 'QLD: 2nd Largest Pig ($' + format(datum.Display_Val_M, ',.0f') + 'M)'))))",
          "as": "note"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "font": "DM Sans",
        "fontSize": 10.5,
        "fontStyle": "italic",
        "fontWeight": "bold",
        "fill": "#1E242B",
        "halo": "#FFFFFF",
        "haloWidth": 2
      },
      "encoding": {
        "longitude": { "field": "lon", "type": "quantitative" },
        "latitude": { "field": "lat", "type": "quantitative" },
        "text": { "field": "note", "type": "nominal" }
      }
    },
    {
      "data": { "url": "data/australian_livestock_disposals_by_state.csv" },
      "transform": [
        { "calculate": "toNumber(datum.Value_AUD)", "as": "Val_Num" },
        { "filter": "datum.Year == YearSelect && datum.Val_Num > 0" },
        {
          "joinaggregate": [
            { "op": "sum", "field": "Val_Num", "as": "State_Total_AUD" }
          ],
          "groupby": ["State"]
        },
        {
          "calculate": "SpeciesSelect == 'All' ? 1 : (datum.Livestock_Type == SpeciesSelect ? 1 : 0)",
          "as": "matches_selection"
        },
        { "filter": "datum.matches_selection == 1" },
        {
          "window": [
            { "op": "row_number", "as": "state_row_idx" }
          ],
          "sort": [{ "field": "Val_Num", "order": "descending" }],
          "groupby": ["State"]
        },
        { "filter": "datum.state_row_idx == 1" },
        {
          "calculate": "SpeciesSelect == 'All' ? (datum.State_Total_AUD / 1000000) : (datum.Val_Num / 1000000)",
          "as": "Display_Val_M"
        },
        {
          "filter": "datum.State == 'Victoria' && (SpeciesSelect == 'All' || SpeciesSelect == 'Sheep' || SpeciesSelect == 'Poultry')"
        },
        {
          "calculate": "SpeciesSelect == 'All' ? 'VIC: 2nd Largest ($7.63B Total)' : (SpeciesSelect == 'Sheep' ? ('VIC: National Sheep Leader ($' + (datum.Display_Val_M >= 1000 ? format(datum.Display_Val_M / 1000, '.2f') + 'B' : format(datum.Display_Val_M, ',.0f') + 'M') + ')') : ('VIC: 2nd Largest Poultry ($' + (datum.Display_Val_M >= 1000 ? format(datum.Display_Val_M / 1000, '.2f') + 'B' : format(datum.Display_Val_M, ',.0f') + 'M') + ')'))",
          "as": "note"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "font": "DM Sans",
        "fontSize": 10.5,
        "fontStyle": "italic",
        "fontWeight": "bold",
        "fill": "#1E242B",
        "halo": "#FFFFFF",
        "haloWidth": 2
      },
      "encoding": {
        "longitude": { "datum": 139.5 },
        "latitude": { "datum": -38.3 },
        "text": { "field": "note", "type": "nominal" }
      }
    }
  ],
  "config": {
    "font": "DM Sans",
    "view": { "stroke": null },
    "legend": {
      "layout": {
        "top": {
          "anchor": "middle",
          "direction": "vertical",
          "margin": 6
        }
      }
    }
  }
}
