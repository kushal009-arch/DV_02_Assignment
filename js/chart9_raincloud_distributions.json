{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 370,
  "height": 220,
  "autosize": "pad",
  "padding": { "top": 15, "left": 15, "right": 35, "bottom": 10 },
  "data": {
    "url": "data/australian_meat_consumption_1988_2025.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Intake_Kg_Person": "number",
        "Year": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "toNumber(datum.Intake_Kg_Person)",
      "as": "Intake_Kg_Person"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "boxplot",
        "extent": "min-max",
        "size": 30,
        "opacity": 0.5,
        "ticks": true,
        "median": { "color": "#0F172A", "size": 2.5 }
      },
      "encoding": {
        "y": {
          "field": "Meat_Type",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": ["Poultry", "Beef & Veal", "Pig Meat", "Sheep Meat"]
          },
          "axis": {
            "labelFontSize": 11.5,
            "labelFontWeight": "bold",
            "labelPadding": 8,
            "domain": true,
            "ticks": true
          }
        },
        "x": {
          "field": "Intake_Kg_Person",
          "type": "quantitative",
          "title": "Per-capita intake (kg / person / year)",
          "scale": { "domain": [0, 60] },
          "axis": {
            "values": [0, 10, 20, 30, 40, 50, 60],
            "grid": true,
            "gridColor": "#F1F5F9",
            "labelFontSize": 10.5,
            "titleFontSize": 11,
            "titlePadding": 8
          }
        },
        "color": {
          "field": "Meat_Type",
          "type": "nominal",
          "scale": {
            "domain": ["Poultry", "Beef & Veal", "Pig Meat", "Sheep Meat"],
            "range": ["#009E73", "#0072B2", "#CC79A7", "#E69F00"]
          },
          "legend": null
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 32,
        "opacity": 0.75,
        "stroke": "#FFFFFF",
        "strokeWidth": 0.8
      },
      "transform": [
        { "calculate": "(random() - 0.5) * 10", "as": "jitter" }
      ],
      "encoding": {
        "y": {
          "field": "Meat_Type",
          "type": "nominal",
          "sort": ["Poultry", "Beef & Veal", "Pig Meat", "Sheep Meat"]
        },
        "yOffset": { "field": "jitter", "type": "quantitative" },
        "x": { "field": "Intake_Kg_Person", "type": "quantitative" },
        "color": { "field": "Meat_Type", "type": "nominal" },
        "tooltip": [
          { "field": "Year", "type": "nominal", "title": "Year" },
          { "field": "Meat_Type", "type": "nominal", "title": "Species" },
          { "field": "Intake_Kg_Person", "type": "quantitative", "format": ".1f", "title": "Intake (kg)" }
        ]
      }
    }
  ],
  "config": {
    "font": "DM Sans",
    "view": { "stroke": null }
  }
}
